APP_ENV=production
DOMAIN=flight-notifier.example.com
BASE_URL=https://flight-notifier.example.com
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://flight_notifier:change-me@postgres:5432/flight_notifier
REDIS_URL=redis://redis:6379/0
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-value
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
SESSION_SECRET=replace-with-a-long-random-value
ALLOWED_ORIGINS=https://flight-notifier.example.com
SCRAPING_ENABLED=false
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT_SECONDS=45
SCRAPER_MIN_DELAY_SECONDS=2
NORMAL_POLL_MINUTES=15
URGENT_POLL_MINUTES=5
URGENT_WINDOW_HOURS=24
MAX_ACTIVE_ALERTS_PER_USER=2
MAX_ALERTS_PER_DAY=30
ADMIN_TELEGRAM_IDS=
VITE_API_BASE_URL=
